# ============================================================
# Environment Variables — Copy to .env and fill in values
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/parkinson_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/parkinson_db

# ---- API Security ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Model Paths ----
MODEL_CHECKPOINT_DIR=./checkpoints
BEST_MODEL_PATH=./checkpoints/best_model.pt

# ---- Streamlit / FastAPI ----
API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501

# ---- Kaggle (for dataset download) ----
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- Feature Config ----
VOICE_SAMPLE_RATE=22050
EEG_SAMPLE_RATE=256
GAIT_SAMPLE_RATE=100

# ---- Training ----
BATCH_SIZE=32
EPOCHS=100
LEARNING_RATE=1e-4
DEVICE=cpu
